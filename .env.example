# Upstream for the same-origin /rpc proxy that the dev and preview servers
# expose. The browser only ever talks to /rpc on the dApp's own origin.
RPC_PROXY_TARGET=https://app.quantumark.fi/rpc/private-testnet

# Optional: read from this URL directly instead of /rpc (it must send valid CORS
# headers), e.g. http://127.0.0.1:8545 through the SSH tunnel.
VITE_RPC_URL=

# RPC URL handed to the wallet in wallet_addQRLChain. Defaults to the public endpoint.
VITE_WALLET_RPC_URL=

# Optional block explorer base URL; "View on explorer" links are hidden when unset.
VITE_EXPLORER_URL=

# Optional: pauli-swap-indexer GraphQL endpoint (e.g. http://127.0.0.1:4000/graphql).
# When set, Explore / pool / token history, pool discovery, holder counts and
# transaction senders come from the indexer; the newest blocks it has not
# indexed yet, and everything when it is down or lags, still come from RPC.
VITE_INDEXER_URL=
# Blocks the indexer may trail the RPC head before the dApp ignores it.
VITE_INDEXER_MAX_LAG=20

# PauliSwap faucet service (pauli-swap-prediction-market `npm run faucet`),
# forwarded at /faucet by the dev and preview servers.
FAUCET_PROXY_TARGET=http://127.0.0.1:8548
# Optional: call the faucet service at this URL instead of /faucet.
VITE_FAUCET_URL=

# Interface fee on swap output (src/lib/fee.ts). Defaults: 25 bips to the
# PauliSwap treasury. 0 turns it off; SwapRouter02 caps it at 100.
VITE_INTERFACE_FEE_BIPS=
VITE_INTERFACE_FEE_RECIPIENT=
